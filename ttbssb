    tx.TextXAlignment = Enum.TextXAlignment.Left
    tx.Active = false

    local switchBg = Instance.new("Frame", btn)
    switchBg.Size = UDim2.new(0, 42, 0, 22)
    switchBg.Position = UDim2.new(1, -54, 0.5, -11)
    switchBg.BackgroundColor3 = Color3.fromRGB(40, 60, 45)
    switchBg.BorderSizePixel = 0
    switchBg.Active = false
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", switchBg)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(180, 200, 185)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = defaultState or false
    local function upd()
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(28, 45, 32)
            st.Color = Settings.C1
            tx.TextColor3 = Color3.fromRGB(255, 255, 255)
            switchBg.BackgroundColor3 = Settings.C1
            knob.Position = UDim2.new(1, -19, 0.5, -8)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(18, 26, 20)
            st.Color = Color3.fromRGB(40, 60, 45)
            tx.TextColor3 = Color3.fromRGB(200, 225, 210)
            switchBg.BackgroundColor3 = Color3.fromRGB(40, 60, 45)
            knob.Position = UDim2.new(0, 3, 0.5, -8)
            knob.BackgroundColor3 = Color3.fromRGB(180, 200, 185)
        end
    end
    btn.Activated:Connect(function()
        state = not state
        upd()
        if callback then callback(state) end
    end)
    upd()
    return btn
end

